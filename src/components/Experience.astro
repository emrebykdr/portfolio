---
interface Props {
  t: Record<string, unknown>;
  lang: string;
}
const { t, lang } = Astro.props;
const exp = t.experience as Record<string, string>;
const isEn = lang === "en";
---

<section id="experience" class="py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="section-title">{exp.title}</h2>
      <p class="section-subtitle">{exp.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Education -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-accent dark:text-accent-dark mb-8">
          {exp.education}
        </h3>
        <div class="relative">
          <div class="absolute left-4 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-800"></div>
          <div class="space-y-8">
            <div class="relative pl-12">
              <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-accent/10 dark:bg-accent-dark/10 border-2 border-accent dark:border-accent-dark flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0v6"/>
                </svg>
              </div>
              <div class="card">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h4 class="font-semibold text-gray-900 dark:text-white">Bitlis Eren Üniversitesi</h4>
                  <span class="tag shrink-0">2022 – {isEn ? "Present" : "Devam"}</span>
                </div>
                <p class="text-sm font-medium text-accent dark:text-accent-dark mb-1">
                  {isEn ? "Computer Engineering" : "Bilgisayar Mühendisliği"}
                </p>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  {isEn
                    ? "Focused on software development, embedded systems, and computer networks."
                    : "Yazılım geliştirme, gömülü sistemler ve bilgisayar ağları alanlarında eğitim."}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Clubs & Responsibilities -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-accent dark:text-accent-dark mb-8">
          {exp.clubs}
        </h3>
        <div class="relative">
          <div class="absolute left-4 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-800"></div>
          <div class="space-y-8">
            <!-- RoboCode -->
            <div class="relative pl-12">
              <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 border-2 border-purple-400 dark:border-purple-500 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
                </svg>
              </div>
              <div class="card">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h4 class="font-semibold text-gray-900 dark:text-white">RoboCode</h4>
                  <span class="tag shrink-0">2022 – {isEn ? "Present" : "Devam"}</span>
                </div>
                <p class="text-sm font-medium text-purple-600 dark:text-purple-400 mb-1">
                  {isEn ? "Founder & President" : "Kurucu Başkan"}
                </p>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  {isEn
                    ? "Founded and lead Bitlis Eren University's robotics and software club. Organizing TEKNOFEST teams, workshops, and inter-club competitions."
                    : "Bitlis Eren Üniversitesi robotik ve yazılım kulübünü kurdu ve yönetiyor. TEKNOFEST takımları, atölye çalışmaları ve kulüpler arası yarışmalar düzenliyor."}
                </p>
              </div>
            </div>

            <!-- TEKNOFEST -->
            <div class="relative pl-12">
              <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-orange-100 dark:bg-orange-900/30 border-2 border-orange-400 dark:border-orange-500 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div class="card">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h4 class="font-semibold text-gray-900 dark:text-white">TEKNOFEST 2026</h4>
                  <span class="tag shrink-0">{isEn ? "Active" : "Aktif"}</span>
                </div>
                <p class="text-sm font-medium text-orange-600 dark:text-orange-400 mb-1">
                  {isEn ? "Team Lead – Unmanned Ground Vehicle" : "Takım Lideri – İnsansız Kara Aracı"}
                </p>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  {isEn
                    ? "Leading the IKA (Unmanned Ground Vehicle) team. Responsible for system architecture, STM32/ESP32 integration, and autonomous navigation algorithms."
                    : "İKA (İnsansız Kara Aracı) takımını yönetiyor. Sistem mimarisi, STM32/ESP32 entegrasyonu ve otonom navigasyon algoritmaları sorumluluğu."}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
