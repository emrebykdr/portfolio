---
interface Props {
  t: Record<string, unknown>;
  lang: string;
}
const { t, lang } = Astro.props;
const contact = t.contact as Record<string, string>;
const apiPath = lang === "en" ? "/api/contact" : "/api/contact";
---

<section id="contact" class="py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="section-title">{contact.title}</h2>
      <p class="section-subtitle">{contact.subtitle}</p>
    </div>

    <div class="max-w-xl mx-auto">
      <div class="card">
        <form id="contact-form" action="/api/contact" method="POST" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
              {contact.name}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder={contact.name_placeholder}
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent dark:focus:ring-accent-dark focus:border-transparent transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
              {contact.email}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={contact.email_placeholder}
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent dark:focus:ring-accent-dark focus:border-transparent transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
              {contact.message}
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder={contact.message_placeholder}
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-accent dark:focus:ring-accent-dark focus:border-transparent transition-all resize-none"
            ></textarea>
          </div>

          <!-- Status messages -->
          <div id="form-success" class="hidden p-4 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 text-sm">
            {contact.success}
          </div>
          <div id="form-error" class="hidden p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 text-sm">
            {contact.error}
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full btn-primary justify-center"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            <span id="submit-text">{contact.send}</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ sendingText: contact.sending, sendText: contact.send }}>
  const form = document.getElementById("contact-form");
  const submitBtn = document.getElementById("submit-btn");
  const submitText = document.getElementById("submit-text");
  const successMsg = document.getElementById("form-success");
  const errorMsg = document.getElementById("form-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitText) return;

    submitBtn.setAttribute("disabled", "true");
    submitText.textContent = sendingText;
    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");

    try {
      const formData = new FormData(form);
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(formData)),
      });

      if (res.ok) {
        successMsg?.classList.remove("hidden");
        form.reset();
      } else {
        errorMsg?.classList.remove("hidden");
      }
    } catch {
      errorMsg?.classList.remove("hidden");
    } finally {
      submitBtn.removeAttribute("disabled");
      submitText.textContent = sendText;
    }
  });
</script>
