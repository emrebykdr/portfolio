---
interface Props {
  t: Record<string, unknown>;
}
const { t } = Astro.props;
const hero = t.hero as Record<string, string>;
---

<section id="home" class="min-h-screen flex items-center pt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 animate-fade-in">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <!-- Text content -->
      <div class="flex-1 space-y-6">
        <!-- Available badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          {hero.available}
        </div>

        <div>
          <p class="text-gray-500 dark:text-gray-400 font-medium mb-2">{hero.greeting}</p>
          <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-gray-900 dark:text-white">
            {hero.name}
          </h1>
          <p class="text-xl sm:text-2xl font-mono text-accent dark:text-accent-dark mt-3">
            {hero.role}
          </p>
        </div>

        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-xl leading-relaxed">
          {hero.pitch}
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="#projects" class="btn-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0l-7 7m7-7l-7-7"/>
            </svg>
            {hero.cta_projects}
          </a>
          <a href="#contact" class="btn-outline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            {hero.cta_contact}
          </a>
        </div>

        <!-- Social links -->
        <div class="flex items-center gap-4 pt-2">
          <a
            href="https://github.com/emrebykdr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/emrebykdr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Avatar -->
      <div class="flex-shrink-0">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80">
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-accent/20 to-purple-500/20 dark:from-accent-dark/20 dark:to-purple-400/20 rotate-6"></div>
          <div class="relative w-full h-full rounded-3xl bg-gray-100 dark:bg-gray-800 overflow-hidden border-2 border-gray-200 dark:border-gray-700 flex items-center justify-center">
            <!-- Placeholder avatar with initials -->
            <span class="text-6xl font-bold text-accent dark:text-accent-dark font-mono">EB</span>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-4 -right-4 bg-white dark:bg-gray-900 rounded-2xl p-3 shadow-lg border border-gray-100 dark:border-gray-800">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-xl bg-accent/10 dark:bg-accent-dark/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-accent dark:text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-900 dark:text-white">C# / .NET</p>
                <p class="text-xs text-gray-500 dark:text-gray-400">Backend</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="mt-20 flex justify-center animate-bounce">
      <a href="#projects" aria-label="Scroll down" class="text-gray-400 dark:text-gray-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
